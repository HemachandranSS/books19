               <rdf:li xml:lang="x-default">Embryo Development Image</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Embryo development image. Human fertilization scheme, the phases of embryo development in the early stages. Vector illustration in red and orange colours isolated on a white background.</rdf:li>
            </rdf:Alt>
         </dc:description>
